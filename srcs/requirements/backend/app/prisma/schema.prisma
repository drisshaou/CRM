generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ColumnType {
  text
  number
  date
  phone
}

model Column {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  type      ColumnType
  position  Int
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("columns")
}

model Contact {
  id        Int      @id @default(autoincrement())
  // Values keyed by column id: { "<columnId>": value }. Prisma Json = jsonb on PostgreSQL.
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contacts")
}